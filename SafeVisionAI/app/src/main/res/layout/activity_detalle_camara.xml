<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">


    <!-- BARRA SUPERIOR -->

    <LinearLayout

        android:layout_width="match_parent"

        android:layout_height="55dp"

        android:gravity="center_vertical"

        android:background="#073A62">


        <TextView

            android:id="@+id/btnRegresar"

            android:layout_width="50dp"

            android:layout_height="match_parent"

            android:gravity="center"

            android:text="←"

            android:textSize="32sp"

            android:textColor="#FFFFFF"/>


        <TextView

            android:id="@+id/txtTituloCamara"

            android:layout_width="wrap_content"

            android:layout_height="match_parent"

            android:gravity="center_vertical"

            android:text="Cámara"

            android:textSize="20sp"

            android:textStyle="bold"

            android:textColor="#FFFFFF"/>


    </LinearLayout>



    <!-- VIDEO -->

    <WebView

        android:id="@+id/webCamaraDetalle"

        android:layout_width="match_parent"

        android:layout_height="300dp"/>



    <!-- FECHA Y HORA -->

    <TextView

        android:id="@+id/txtFechaHora"

        android:layout_width="match_parent"

        android:layout_height="45dp"

        android:gravity="center"

        android:text="16/09/2026 21:30:20"

        android:textSize="16sp"

        android:textStyle="bold"

        android:textColor="#333333"/>



    <!-- ESTADO PERSONA (RETROCOMPATIBILIDAD) -->
    <TextView
        android:id="@+id/txtEstadoPersona"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center"
        android:text="🟢 En línea"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="#00A85A"/>

    <!-- PANEL DE ESTADO EPP (CASCO + CHALECO) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:padding="16dp"
        android:background="#F5F7FA"
        android:gravity="center">

        <!-- ESTADO GENERAL EPP -->
        <TextView
            android:id="@+id/txtEstadoEpp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESTADO: BUSCANDO PERSONA"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FF9800"/>

        <!-- ESTADO CASCO -->
        <TextView
            android:id="@+id/txtEstadoCasco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="CASCO: --"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <!-- ESTADO CHALECO -->
        <TextView
            android:id="@+id/txtEstadoChaleco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="CHALECO: --"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

    </LinearLayout>



</LinearLayout>