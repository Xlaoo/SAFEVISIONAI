<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020D1D"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="55dp"
        android:paddingEnd="28dp"
        android:paddingBottom="35dp">

        <!-- VOLVER -->

        <TextView
            android:id="@+id/btnVolverRecuperar"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="10dp"
            android:text="‹  Volver"
            android:textColor="#71AFFF"
            android:textSize="15sp"
            android:textStyle="bold" />


        <!-- CONTENIDO CENTRAL -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="58dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- ÍCONO CORREO -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="78dp"
                android:layout_height="78dp"
                app:cardBackgroundColor="#0A2344"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="#00BFFF"
                app:strokeWidth="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="✉"
                    android:textColor="#00D4FF"
                    android:textSize="34sp" />

            </com.google.android.material.card.MaterialCardView>


            <!-- TÍTULO -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center"
                android:text="Recuperar Contraseña"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />


            <!-- DESCRIPCIÓN -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Ingresa tu correo electrónico y te enviaremos las instrucciones para recuperar tu acceso."
                android:textColor="#91ADD0"
                android:textSize="14sp" />


            <!-- CORREO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:layout_marginBottom="7dp"
                android:text="CORREO ELECTRÓNICO"
                android:textColor="#8EA8C5"
                android:textSize="10sp"
                android:textStyle="bold" />


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutCorreoRecuperar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundColor="#081A31"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="13dp"
                app:boxCornerRadiusBottomStart="13dp"
                app:boxCornerRadiusTopEnd="13dp"
                app:boxCornerRadiusTopStart="13dp"
                app:boxStrokeColor="#1766A5"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtCorreoRecuperar"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:hint="correo@empresa.com"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#58728F"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- BOTÓN ENVIAR -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnviarInstrucciones"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.08"
                android:text="ENVIAR INSTRUCCIONES"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="#0A84FF"
                app:cornerRadius="13dp" />


            <!-- MENSAJE INFORMATIVO -->

            <TextView
                android:id="@+id/txtMensajeRecuperar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text=""
                android:textColor="#00D4FF"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>