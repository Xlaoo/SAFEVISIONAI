<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_reporte"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- FILA SUPERIOR: NOMBRE, ÁREA Y BOTÓN VER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNombreTrabajadorReporte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del Trabajador"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAreaTrabajadorReporte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Producción"
                android:textColor="#64748B"
                android:textSize="13sp" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerTrabajadorReporte"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="#073A62"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="76dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="VER"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="#F1F5F9" />

    <!-- INFORMACIÓN DE INCIDENCIAS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Veces reportado: "
            android:textColor="#334155"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtVecesReportado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#D32F2F"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Último reporte: "
            android:textColor="#334155"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtUltimoReporte"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--/--/---- --:--"
            android:textColor="#475569"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>
