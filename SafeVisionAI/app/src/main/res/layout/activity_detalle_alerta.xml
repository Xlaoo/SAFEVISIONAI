<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <!-- ================================================= -->
        <!-- BARRA SUPERIOR -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#073A62"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnRegresarDetalle"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:text="←"
                android:textSize="32sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detalle de alerta"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- INFORMACIÓN DE LA ALERTA -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtTituloDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alerta"
            android:textColor="#073A62"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp"/>


        <TextView
            android:id="@+id/txtFechaDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha"
            android:textColor="#555555"
            android:textSize="15sp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp"/>


        <TextView
            android:id="@+id/txtAreaDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Área"
            android:textColor="#555555"
            android:textSize="15sp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="10dp"/>


        <!-- ================================================= -->
        <!-- FOTOS DE LA ALERTA -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Evidencia de la alerta"
            android:textColor="#073A62"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"/>


        <!-- FOTO 1 -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📸 Captura completa"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="6dp"/>


        <ImageView
            android:id="@+id/imgFotoNormal"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="#DDE3E8"
            android:scaleType="fitCenter"
            android:contentDescription="Foto completa de la alerta"/>


        <!-- FOTO 2 -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔍 Captura ampliada"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="6dp"/>


        <ImageView
            android:id="@+id/imgFotoZoom"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="#DDE3E8"
            android:scaleType="fitCenter"
            android:contentDescription="Foto ampliada de la alerta"/>


        <!-- ================================================= -->
        <!-- BOTÓN REGISTRAR ACCIÓN -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/btnRegistrarAccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar acción"
            android:textAllCaps="false"
            android:layout_margin="20dp"/>

    </LinearLayout>

</ScrollView>