<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020D1D"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="30dp">

        <!-- LOGO -->
        <ImageView
            android:id="@+id/imgLogoRegistro"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="Logo SafeVision AI"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher" />

        <!-- NOMBRE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.18"
            android:text="SAFEVISION AI"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- SUBTÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.12"
            android:text="SEGURIDAD EN TIEMPO REAL"
            android:textColor="#00D4FF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- TARJETA -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#07172C"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#14558D"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="CREAR CUENTA"
                    android:textColor="#D1E4FA"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="18dp"
                    android:text="Registra tus datos para acceder al sistema"
                    android:textColor="#7895B5"
                    android:textSize="12sp" />

                <!-- NOMBRES -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="NOMBRES"
                    android:textColor="#8EA8C5"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="#081A31"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="11dp"
                    app:boxCornerRadiusBottomStart="11dp"
                    app:boxCornerRadiusTopEnd="11dp"
                    app:boxCornerRadiusTopStart="11dp"
                    app:boxStrokeColor="#1766A5"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtNombres"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:hint="Ingresa tus nombres"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#58728F"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- APELLIDOS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:layout_marginBottom="6dp"
                    android:text="APELLIDOS"
                    android:textColor="#8EA8C5"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="#081A31"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="11dp"
                    app:boxCornerRadiusBottomStart="11dp"
                    app:boxCornerRadiusTopEnd="11dp"
                    app:boxCornerRadiusTopStart="11dp"
                    app:boxStrokeColor="#1766A5">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtApellidos"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:hint="Ingresa tus apellidos"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#58728F"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- DNI -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:layout_marginBottom="6dp"
                    android:text="DNI"
                    android:textColor="#8EA8C5"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="#081A31"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="11dp"
                    app:boxCornerRadiusBottomStart="11dp"
                    app:boxCornerRadiusTopEnd="11dp"
                    app:boxCornerRadiusTopStart="11dp"
                    app:boxStrokeColor="#1766A5">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtDni"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:hint="12345678"
                        android:inputType="number"
                        android:maxLength="8"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#58728F"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- TELÉFONO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:layout_marginBottom="6dp"
                    android:text="TELÉFONO"
                    android:textColor="#8EA8C5"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="#081A31"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="11dp"
                    app:boxCornerRadiusBottomStart="11dp"
                    app:boxCornerRadiusTopEnd="11dp"
                    app:boxCornerRadiusTopStart="11dp"
                    app:boxStrokeColor="#1766A5">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtTelefono"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:hint="999999999"
                        android:inputType="phone"
                        android:maxLength="9"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#58728F"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- CORREO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:layout_marginBottom="6dp"
                    android:text="CORREO ELECTRÓNICO"
                    android:textColor="#8EA8C5"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="#081A31"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="11dp"
                    app:boxCornerRadiusBottomStart="11dp"
                    app:boxCornerRadiusTopEnd="11dp"
                    app:boxCornerRadiusTopStart="11dp"
                    app:boxStrokeColor="#1766A5">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtCorreo"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:hint="usuario@empresa.com"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#58728F"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- CONTRASEÑA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:layout_marginBottom="6dp"
                    android:text="CONTRASEÑA"
                    android:textColor="#8EA8C5"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="#081A31"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="11dp"
                    app:boxCornerRadiusBottomStart="11dp"
                    app:boxCornerRadiusTopEnd="11dp"
                    app:boxCornerRadiusTopStart="11dp"
                    app:boxStrokeColor="#1766A5"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtPassword"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:hint="Crea una contraseña segura"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#58728F"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- CONFIRMAR CONTRASEÑA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:layout_marginBottom="6dp"
                    android:text="CONFIRMAR CONTRASEÑA"
                    android:textColor="#8EA8C5"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="#081A31"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="11dp"
                    app:boxCornerRadiusBottomStart="11dp"
                    app:boxCornerRadiusTopEnd="11dp"
                    app:boxCornerRadiusTopStart="11dp"
                    app:boxStrokeColor="#1766A5"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtConfirmarPassword"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:hint="Repite tu contraseña"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#58728F"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- BOTÓN -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegistrar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="22dp"
                    android:letterSpacing="0.12"
                    android:text="CREAR CUENTA"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#0A84FF"
                    app:cornerRadius="12dp" />

                <!-- VOLVER LOGIN -->
                <TextView
                    android:id="@+id/txtVolverLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="9dp"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="¿Ya tienes una cuenta? Iniciar sesión"
                    android:textColor="#00C8FF"
                    android:textSize="13sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- FOOTER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="17dp"
            android:text="SafeVision AI v1.0 • Sistema Industrial EPP"
            android:textColor="#315477"
            android:textSize="10sp" />

    </LinearLayout>

</ScrollView>